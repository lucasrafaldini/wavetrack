# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/wavetrack
/seed_history

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Environment file
.env

# Data and logs (generated at runtime)
data/
logs/
*.db
*.log
*.json

# Backup files
*.bak
*_old.*
*_backup.*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
.tmp/

# WaveTrack specific
.wavetrack/
